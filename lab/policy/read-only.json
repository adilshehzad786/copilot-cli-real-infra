{
  "sandbox": {
    "enabled": true,
    "allowBypass": false,
    "addCurrentWorkingDirectory": false,
    "allowDevToolAccess": false,
    "sandboxMcpServers": true,
    "sandboxLspServers": true,
    "auth": {
      "git": false,
      "gh": false
    },
    "userPolicy": {
      "filesystem": {
        "readonlyPaths": [
          "__LAB__"
        ],
        "readwritePaths": [],
        "deniedPaths": [
          "__LAB__/.env",
          "__HOME__/.aws",
          "__HOME__/.azure",
          "__HOME__/.config/gcloud",
          "__HOME__/.config/gh",
          "__HOME__/.kube",
          "__HOME__/.ssh",
          "__HOME__/.gitconfig",
          "__HOME__/.netrc",
          "__HOME__/.git-credentials",
          "__HOME__/.docker",
          "__HOME__/.npmrc",
          "__HOME__/.terraform.d",
          "__HOME__/.gnupg"
        ]
      },
      "network": {
        "allowOutbound": false,
        "allowLocalNetwork": false
      },
      "seatbelt": {
        "keychainAccess": false
      }
    }
  }
}
