# Expected local review answer. Not a deployment or migration recipe.
terraform {
  required_version = ">= 1.5"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = "me-central2"
}

variable "project_id" {
  description = "Synthetic project identifier; this fixture must not be deployed."
  type        = string
}

resource "google_storage_bucket" "reports" {
  name                        = "${var.project_id}-reports"
  location                    = "ME-CENTRAL2"
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  force_destroy               = false

  versioning {
    enabled = true
  }

  # Set lifecycle rules only after the required retention policy is agreed.
}

# google_storage_bucket_iam_member.public is deleted, not rewritten. The resource
# is non-authoritative, so removing the block removes exactly that one binding.
# With public_access_prevention enforced it cannot be re-added.
